# Remitente verificado en SES (en AWS: SSM /<amb>/<app>/notifications/from-email)
SES_FROM_EMAIL=
# Variables para ejecutar el backend localmente y los tests de integración.
# En AWS las define template.yaml (Globals + Parameters); NUNCA poner passwords aquí ni en samconfig.
ENVIRONMENT=dev
SERVICE_NAME=movilidad
LOG_LEVEL=DEBUG
DB_SECRET_NAME=/dev/movilidad/db/app
DB_NAME=olo_dev_movilidad_db
DB_PROXY_ENDPOINT=localhost
DB_PORT=5432
DB_SSLMODE=disable
ALLOWED_ORIGINS=http://localhost:5173
# Tests de integración (PostgreSQL local/efímero con los scripts de migration-output/database aplicados)
TEST_DATABASE_URL=postgresql://usr_movilidad_app@localhost:5432/olo_dev_movilidad_db
